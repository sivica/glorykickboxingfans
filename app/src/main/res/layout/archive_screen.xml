<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_content" android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- Insets belong to the wrapper; keeping the scroll viewport unpadded preserves reachability. -->
    <ScrollView android:id="@+id/screen_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/archive_header" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@color/archive_ink" android:padding="@dimen/archive_screen_inset">
                <TextView android:id="@+id/back_action" style="@style/ArchiveAction" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:padding="0dp" android:background="?attr/selectableItemBackground"
                    android:textColor="@color/archive_paper" android:text="@string/archive_back" android:visibility="gone" />
                <TextView android:id="@+id/screen_title" style="@style/ArchiveText.Title" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
                <TextView android:id="@+id/screen_subtitle" style="@style/ArchiveText.Meta" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/archive_paper" />
            </LinearLayout>
            <TextView android:id="@+id/demo_banner" style="@style/ArchiveText.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@color/archive_lime" android:textColor="@color/archive_ink"
                android:gravity="center" android:padding="8dp" android:text="@string/archive_demo_banner" />
            <LinearLayout android:id="@+id/screen_content" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/archive_screen_inset" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
